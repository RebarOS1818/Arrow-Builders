# Supabase — Project Settings → API
# Without these the app runs on its bundled demo dataset.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe — a flat monthly fee per plan. Without these the billing page is
# read-only.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# One Price per self-serve tier. Set an `included_seats` metadata key on each
# Price to set that plan's user allowance without a deploy. Enterprise has no
# Price on purpose — it is arranged by hand, not bought online.
# STRIPE_PRICE_ID (unsuffixed) is still accepted as Starter, so an install that
# predates tiers keeps working.
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PREMIUM=price_...

# Where the Enterprise card's "Contact us" button writes to. Leave unset and the
# card shows no link.
NEXT_PUBLIC_SALES_EMAIL=sales@yourdomain.com

# Service-role key (Project Settings → API). Server-only, used by the Stripe
# webhook (no user session to act as) and to send invite emails through Supabase
# Auth's admin API. Invite emails go out via whatever SMTP provider is set under
# Supabase → Project Settings → Auth → SMTP Settings; without it the app still
# creates invites and shows a copyable link.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical app URL for Stripe redirects. Vercel infers this if unset.
NEXT_PUBLIC_APP_URL=https://arrow-builders.vercel.app

# ------------------------------------------------------------------ addresses
# Google Maps Platform key, used server-side only for address autocomplete on
# the property and comparable forms. Enable the "Places API (New)" on the key.
#
# Deliberately not NEXT_PUBLIC_: the key never reaches the browser, because a
# key in client JavaScript can be lifted from the page and spent by anyone who
# finds it. Requests are proxied through /api/places, which requires a signed-in
# session, so only members of an organization can spend the quota.
#
# Leave unset and the address fields stay plain text inputs — everything else
# on those forms works exactly the same.
GOOGLE_MAPS_API_KEY=

# Optional ISO country code to bias suggestions, e.g. US. Unset searches
# worldwide.
GOOGLE_PLACES_REGION=
